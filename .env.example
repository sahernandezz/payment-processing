# Database
POSTGRES_USER=payments
POSTGRES_PASSWORD=change_me
POSTGRES_DB=payment_processing
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://payments:change_me@postgres:5432/payment_processing

# Redis (sessions + Celery broker)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Auth
JWT_SECRET=change_me_use_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Reconciliation
PENDING_TIMEOUT_MINUTES=30
RECONCILIATION_INTERVAL_SECONDS=300

# Seed (bootstrap admin + optional service API key)
ADMIN_EMAIL=admin@payments.com
ADMIN_PASSWORD=admin12345
SERVICE_API_KEY=local-service-key-change-me

# App
LOG_LEVEL=INFO
# Base URL publicada en el bloque `servers` del OpenAPI
PUBLIC_URL=http://localhost:8000
# Endpoints de demo (generar pagos de prueba). Nunca activar en producción.
DEMO_ENDPOINTS_ENABLED=true
